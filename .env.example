# Read-only by default. Requires approved sudo helper when enabled.
LINUX_ENABLE_INSTALL=false
# Optional shell command execution (regular user only).
LINUX_ENABLE_TERMINAL=false
# Default: .runtime/workspace. Set an approved server editing directory.
LINUX_WORKSPACE_ROOT=
# Optional admin operations: nginx apply / Certbot / services through the sudo helper.
LINUX_ENABLE_ADMIN=false
# Explicit opt-in for changes to the managed sudo helper rule
LINUX_ENABLE_SUDO_POLICY=false
# Optional cron writes: current non-root user only.
LINUX_ENABLE_CRON=false

# AI log analysis (external transmission requires per-request consent)
LINUX_ENABLE_AI=false
LINUX_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Required web login. Generate the hash with scripts/login-hash.mjs.
LINUX_LOGIN_USERNAME=admin
LINUX_LOGIN_PASSWORD_HASH=
# Enable when served over HTTPS.
LINUX_COOKIE_SECURE=false
# Public application origin for Better Auth (set your actual HTTPS URL in production).
BETTER_AUTH_URL=http://127.0.0.1:8791
